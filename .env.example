# Database Configuration
MYSQL_DATABASE=nebuladb
MYSQL_USERNAME=nebula_user
MYSQL_PASSWORD=your_strong_password_here

# JWT Configuration
JWT_SECRET_KEY=your_32_character_long_secret_key_here_change_this_in_production

# Server Ports (optional - services have defaults)
# SERVICE_NAME_PORT=8000

# Eureka Configuration (optional)
# EUREKA_HOSTNAME=localhost
# EUREKA_PORT=8761

# Kafka Configuration (optional)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Additional environment variables as needed